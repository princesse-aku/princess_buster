{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Princess Buster",
  "version": "0.1.0",
  "identifier": "com.princessbuster.game",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Princess Buster",
        "width": 540,
        "height": 960,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Fais tomber toutes les technos !",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
