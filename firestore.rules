rules_version = '2';
// Règles Firestore de Princess Buster : chaque joueur (compte Google, ou compte anonyme pour l'invité) n'écrit que ses propres données.
//  - players/{uid}                    : profil PUBLIC (nom, avatar, scores) lisible par tous : sert au classement
//  - players/{uid}/progress/{niveau}  : progression détaillée, lisible par le joueur seul
//  - players/{uid}/private/profile    : infos du compte et de l'appareil, statistiques, réglages : le joueur seul
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function num(d, k) { return d.get(k, 0); }

    match /players/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'totalScore', 'levelsDone', 'maxLevel', 'totalStars', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.totalScore == 0
        && request.resource.data.levelsDone == 0;

      // les scores ne font que monter : au plus 220 points / 1 niveau / 3 étoiles par écriture, avec des plafonds globaux
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'totalScore', 'levelsDone', 'maxLevel', 'totalStars', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name)
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar < 100))
        && request.resource.data.totalScore >= num(resource.data, 'totalScore')
        && request.resource.data.totalScore - num(resource.data, 'totalScore') <= 220
        && request.resource.data.totalScore <= 250 * 220
        && request.resource.data.levelsDone >= num(resource.data, 'levelsDone')
        && request.resource.data.levelsDone - num(resource.data, 'levelsDone') <= 1
        && request.resource.data.levelsDone <= 250
        && num(request.resource.data, 'maxLevel') >= num(resource.data, 'maxLevel')
        && num(request.resource.data, 'maxLevel') <= 250
        && num(request.resource.data, 'totalStars') >= num(resource.data, 'totalStars')
        && num(request.resource.data, 'totalStars') - num(resource.data, 'totalStars') <= 3
        && num(request.resource.data, 'totalStars') <= 250 * 3;

      // un invité (compte anonyme) qui rejoint un compte Google existant retire son entrée du classement
      allow delete: if isOwner(uid) && request.auth.token.firebase.sign_in_provider == 'anonymous';

      match /progress/{level} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && level.matches('^[0-9]+$') && int(level) >= 1 && int(level) <= 250
          && request.resource.data.keys().hasOnly(['level', 'bestScore', 'stars', 'ballsLeft', 'attempts', 'wins', 'completed', 'updatedAt'])
          && request.resource.data.level == int(level)
          && request.resource.data.bestScore is int && request.resource.data.bestScore >= 0 && request.resource.data.bestScore <= 220
          && num(request.resource.data, 'stars') >= 0 && num(request.resource.data, 'stars') <= 3
          && num(request.resource.data, 'ballsLeft') >= 0 && num(request.resource.data, 'ballsLeft') <= 200
          && request.resource.data.attempts is int && request.resource.data.attempts >= 0
          && num(request.resource.data, 'wins') >= 0
          && (request.resource.data.completed == 0 || request.resource.data.completed == 1)
          && (resource == null || request.resource.data.bestScore >= resource.data.bestScore);
        allow delete: if false;
      }

      match /private/{doc} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && doc == 'profile'
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'locale', 'timezone', 'platform', 'userAgent', 'screen', 'appVersion', 'installed',
              'logins', 'firstLoginAt', 'lastLoginAt', 'plays', 'wins', 'losses', 'lastLevel', 'lastPlayedAt', 'settings']);
        allow delete: if false;
      }
    }
  }
}
